{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Showcase Profile",
  "description": "A schema for the data used in the showcase-yourself project. Fetched at runtime from /showcase.json, so one image can serve different profiles per deployment.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "github_username": {
      "type": "string",
      "description": "Optional -- only needed if pinned_repositories/top_repositories are used for a GitHub-portfolio-style profile."
    },
    "profile": {
      "type": "object",
      "properties": {
        "tag_line": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "actively_looking": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "blog": {
          "type": "string"
        }
      },
      "required": ["tag_line", "summary", "actively_looking", "location", "blog"]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["name", "url"]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pinned_repositories": {
      "type": "array",
      "description": "Optional -- for a GitHub-portfolio-style profile.",
      "items": {
        "$ref": "#/definitions/repository"
      }
    },
    "top_repositories": {
      "type": "array",
      "description": "Optional -- for a GitHub-portfolio-style profile.",
      "items": {
        "$ref": "#/definitions/repository"
      }
    },
    "experience": {
      "type": "array",
      "description": "Optional -- for a resume-style profile. Rendered as a work history timeline.",
      "items": {
        "$ref": "#/definitions/experience"
      }
    },
    "education": {
      "type": "array",
      "description": "Optional -- for a resume-style profile.",
      "items": {
        "$ref": "#/definitions/education"
      }
    }
  },
  "required": ["name", "profile", "links", "skills"],
  "definitions": {
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "stars": {
          "type": "integer"
        },
        "forks": {
          "type": "integer"
        },
        "language": {
          "type": "string"
        }
      },
      "required": ["name", "description", "url", "stars", "forks", "language"]
    },
    "experience": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["title", "company", "start_date", "highlights"]
    },
    "education": {
      "type": "object",
      "properties": {
        "school": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "required": ["school", "credential"]
    }
  }
}
